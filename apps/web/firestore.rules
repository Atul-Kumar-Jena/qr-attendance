rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /institutions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /students/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /teacherPerms/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /remarks/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
