rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /institutions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /students/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /teacherPerms/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /remarks/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /sessions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /auditLogs/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /classes/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /classMembers/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /attendanceRecords/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /schedules/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /interests/{id} {
      allow read, write: if true;
    }

    // ── Secure attendance pipeline ──────────────────────────────────────────
    // Sessions: signed-in users may create/read. (Server enforces role on
    // POST /sessions; this rule preserves admin/teacher dashboard reads.)
    match /attendanceSessions/{sid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // Attendance records — ONLY the Cloud Function (admin SDK) may write.
      match /records/{recId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Scan attempts log — admin SDK only.
    match /scanAttempts/{att} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bound student devices — TOFU is performed server-side; clients cannot
    // forge a binding.
    match /studentDevices/{sid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
