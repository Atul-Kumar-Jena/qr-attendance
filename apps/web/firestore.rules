rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site config: readable by anyone, writable by any authenticated user.
    // In production, add: && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection: user can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
