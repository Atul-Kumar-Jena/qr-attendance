	<string>Attendly uses your location to verify you are within the classroom geofence.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to securely unlock Attendly.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
